{
  "title": "DeployPilot",
  "uid": "deploypilot-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "API requests/sec", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (route,status) (rate(deploypilot_api_requests_total[5m]))", "legendFormat": "{{route}} {{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "API latency p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le,route) (rate(deploypilot_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 3, "type": "timeseries", "title": "Controller reconciliations", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(controller_runtime_reconcile_total[5m]))", "legendFormat": "reconciles/sec"}]},
    {"id": 4, "type": "stat", "title": "Controller up", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8}, "targets": [{"expr": "up{job=~\"deploypilot.*\"}", "legendFormat": "{{job}}"}]},
    {"id": 5, "type": "stat", "title": "Active requests", "gridPos": {"h": 8, "w": 3, "x": 18, "y": 8}, "targets": [{"expr": "deploypilot_deployment_requests{state=\"active\"}", "legendFormat": "active"}]},
    {"id": 6, "type": "stat", "title": "Failed requests", "gridPos": {"h": 8, "w": 3, "x": 21, "y": 8}, "targets": [{"expr": "deploypilot_deployment_requests{state=\"failed\"}", "legendFormat": "failed"}]}
  ]
}
